          <TableColumn fx:id="totalCustomersCol" prefWidth="112.0" text="Total Customers" />
            <TableColumn fx:id="appointmentsCol" prefWidth="132.0" text="Appointments" />
            <TableColumn fx:id="completedJobsCol" prefWidth="133.0" text="Completed Jobs" />
