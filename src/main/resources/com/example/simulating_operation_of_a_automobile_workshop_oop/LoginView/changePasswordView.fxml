<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.simulating_operation_of_a_automobile_workshop_oop.Login.Controller.changePasswordViewController">
   <children>
      <Label layoutX="217.0" layoutY="46.0" text="Change Password" underline="true">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Button fx:id="backButton" layoutX="28.0" layoutY="27.0" mnemonicParsing="false" text="&lt; Back" />
      <Label layoutX="105.0" layoutY="107.0" text="Current Password:">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <PasswordField fx:id="currentPasswordField" layoutX="268.0" layoutY="104.0" prefWidth="230.0" />
      <Label layoutX="105.0" layoutY="158.0" text="New Password:">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <PasswordField fx:id="newPasswordField" layoutX="268.0" layoutY="155.0" prefWidth="230.0" />
      <Label layoutX="105.0" layoutY="215.0" text="Confirm New Password:">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <PasswordField fx:id="confirmNewPasswordField" layoutX="268.0" layoutY="212.0" prefWidth="230.0" />
      <Button layoutX="225.0" layoutY="291.0" mnemonicParsing="false" onAction="#changePasswordButton" prefHeight="35.0" prefWidth="150.0" text="Change Password" />
   </children>
</AnchorPane>
