<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.simulating_operation_of_a_automobile_workshop_oop.ServiceAdvisor.Controller.assignTechnicianViewController">
   <children>
      <Button layoutX="14.0" layoutY="16.0" mnemonicParsing="false" onAction="#backButton" text="&lt; Back" />
      <Label layoutX="216.0" layoutY="28.0" text="Assign Technician" underline="true">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <TableView fx:id="pendingJobCardTableView" layoutX="16.0" layoutY="80.0" prefHeight="190.0" prefWidth="568.0">
         <columns>
            <TableColumn fx:id="jobCardIdColumn" prefWidth="162.0" text="Job Card ID" />
            <TableColumn fx:id="vehicleColumn" prefWidth="219.0" text="Vehicle" />
            <TableColumn fx:id="statusColumn" prefWidth="251.0" text="Status" />
         </columns>
      </TableView>
      <Label layoutX="40.0" layoutY="315.0" text="Technician:">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <ComboBox fx:id="technicianComboBox" layoutX="130.0" layoutY="312.0" prefWidth="280.0" promptText="Select Technician" />
      <Button layoutX="255.0" layoutY="345.0" mnemonicParsing="false" onAction="#saveButton" prefHeight="35.0" prefWidth="90.0" text="Save" />
      <Label layoutX="40.0" layoutY="281.0" text="Job ID">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <ComboBox fx:id="jobCardIdComboBox" layoutX="130.0" layoutY="278.0" prefWidth="280.0" promptText="Select Job Card ID" />
   </children>
</AnchorPane>
