<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.simulating_operation_of_a_automobile_workshop_oop.ServiceAdvisor.Controller.customerManagementViewController">
   <children>
      <TableView fx:id="customerTableView" layoutX="7.0" layoutY="150.0" prefHeight="173.0" prefWidth="635.0">
        <columns>
          <TableColumn fx:id="customerIdColumn" prefWidth="82.0" text="Customer ID" />
          <TableColumn fx:id="nameColumn" prefWidth="126.0" text="Name" />
            <TableColumn fx:id="phoneColumn" minWidth="0.0" prefWidth="120.0" text="Phone" />
            <TableColumn fx:id="emailColumn" minWidth="0.0" prefWidth="153.0" text="Email" />
            <TableColumn fx:id="addressColumn" prefWidth="153.0" text="Address" />
        </columns>
      </TableView>
      <Button layoutX="236.0" layoutY="338.0" mnemonicParsing="false" onAction="#addCustomerButton" prefHeight="39.0" prefWidth="150.0" text="Add Customer" />
      <Button layoutX="410.0" layoutY="86.0" mnemonicParsing="false" onAction="#searchButton" prefHeight="39.0" prefWidth="99.0" text="Search" />
      <Label layoutX="200.0" layoutY="45.0" text="Customer Management" underline="true">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <TextField fx:id="searchField" layoutX="220.0" layoutY="86.0" prefHeight="39.0" prefWidth="182.0" />
      <Button layoutX="26.0" layoutY="26.0" mnemonicParsing="false" onAction="#backButton" text="&lt; Back" />
   </children>
</AnchorPane>
