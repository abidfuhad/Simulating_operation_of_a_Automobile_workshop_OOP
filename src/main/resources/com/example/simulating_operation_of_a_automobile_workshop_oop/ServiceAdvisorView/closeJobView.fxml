<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.simulating_operation_of_a_automobile_workshop_oop.ServiceAdvisor.Controller.closeJobViewController">
   <children>
      <Button layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#backButton" text="&lt; Back" />
      <Label layoutX="255.0" layoutY="39.0" text="Close Job" underline="true">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <TableView fx:id="closableJobCardTableView" layoutX="51.0" layoutY="100.0" prefHeight="200.0" prefWidth="499.0">
         <columns>
            <TableColumn fx:id="jobIdColumn" prefWidth="134.0" text="Job ID" />
            <TableColumn fx:id="vehicleColumn" prefWidth="224.0" text="Vehicle" />
            <TableColumn fx:id="statusColumn" prefWidth="140.0" text="Status" />
         </columns>
      </TableView>
      <Button layoutX="230.0" layoutY="345.0" mnemonicParsing="false" onAction="#closeJobButton" prefHeight="35.0" prefWidth="140.0" text="Close Job" />
      <ComboBox fx:id="completedJobIdComboBox" layoutX="166.0" layoutY="309.0" prefWidth="150.0" promptText="Select Job ID" />
      <Label layoutX="52.0" layoutY="313.0" text="Completed Job ID:">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
