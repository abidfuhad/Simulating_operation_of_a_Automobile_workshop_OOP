<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.simulating_operation_of_a_automobile_workshop_oop.Technician.Controller.recordLabourHoursViewController">
   <children>
      <Label layoutX="200.0" layoutY="25.0" text="Record Labour Hours" underline="true">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Button layoutX="24.0" layoutY="24.0" mnemonicParsing="false" onAction="#backButton" text="&lt; Back" />
      <TableView fx:id="assignedJobTableView" layoutX="24.0" layoutY="79.0" prefHeight="185.0" prefWidth="574.0">
         <columns>
            <TableColumn fx:id="jobIdColumn" prefWidth="113.0" text="Job ID" />
            <TableColumn fx:id="vehicleColumn" prefWidth="141.0" text="Vehicle" />
            <TableColumn fx:id="complaintColumn" prefWidth="194.0" text="Complaint" />
            <TableColumn fx:id="statusColumn" prefWidth="125.0" text="Status" />
         </columns>
      </TableView>
      <Label layoutX="26.0" layoutY="374.0" text="Total Hours:">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <TextField fx:id="totalHoursField" layoutX="108.0" layoutY="371.0" prefWidth="110.0" />
      <Label layoutX="30.0" layoutY="280.0" text="Job">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <ComboBox fx:id="jobSelectComboBox" layoutX="70.0" layoutY="277.0" prefWidth="220.0" promptText="Select Job" />
      <Label layoutX="30.0" layoutY="311.0" text="Start Time:">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <TextField fx:id="startTimeField" layoutX="108.0" layoutY="308.0" prefWidth="110.0" />
      <Label layoutX="33.0" layoutY="342.0" text="End Time:">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <TextField fx:id="endTimeField" layoutX="108.0" layoutY="339.0" prefWidth="110.0" />
      <Button layoutX="391.0" layoutY="316.0" mnemonicParsing="false" onAction="#saveButton" prefHeight="35.0" prefWidth="120.0" text="Save" />
   </children>
</AnchorPane>
