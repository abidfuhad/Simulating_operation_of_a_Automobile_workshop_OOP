<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.simulating_operation_of_a_automobile_workshop_oop.Technician.Controller.acceptJobViewController">
   <children>
      <Label layoutX="248.0" layoutY="31.0" text="Accept Job" underline="true">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Button layoutX="21.0" layoutY="18.0" mnemonicParsing="false" onAction="#backButton" text="&lt; Back" />
      <Label layoutX="25.0" layoutY="77.0" text="Filter by Status:">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <ComboBox fx:id="statusFilterComboBox" layoutX="131.0" layoutY="74.0" prefWidth="220.0" promptText="Select Status" />
      <TableView fx:id="assignedJobTableView" layoutX="40.0" layoutY="108.0" prefHeight="229.0" prefWidth="519.0">
         <columns>
            <TableColumn fx:id="jobIdColumn" prefWidth="123.0" text="Job ID" />
            <TableColumn fx:id="vehicleColumn" prefWidth="117.0" text="Vehicle" />
            <TableColumn fx:id="complaintColumn" prefWidth="150.0" text="Complaint" />
            <TableColumn fx:id="statusColumn" prefWidth="128.0" text="Status" />
         </columns>
      </TableView>
      <Label layoutX="47.0" layoutY="348.0" text="Select Job:">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <ComboBox fx:id="jobSelectComboBox" layoutX="122.0" layoutY="345.0" prefWidth="150.0" promptText="Select Job" />
      <Button layoutX="335.0" layoutY="340.0" mnemonicParsing="false" onAction="#acceptButton" prefHeight="35.0" prefWidth="120.0" text="Accept" />
   </children>
</AnchorPane>
