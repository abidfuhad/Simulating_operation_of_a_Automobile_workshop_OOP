<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.simulating_operation_of_a_automobile_workshop_oop.HRManager.Controller.RecordAttendanceViewController">
   <children>
      <Label fx:id="employeeIdLabel" layoutX="22.0" layoutY="37.0" prefHeight="17.0" prefWidth="83.0" text="Employee ID :" />
      <ComboBox fx:id="employeeIdComboBox" layoutX="109.0" layoutY="33.0" prefWidth="150.0" />
      <Label fx:id="employeeNameLabel" layoutX="11.0" layoutY="81.0" prefHeight="17.0" prefWidth="105.0" text="Employee Name :" />
      <TextField fx:id="employeeNameTextField" layoutX="109.0" layoutY="77.0" />
      <Label fx:id="dateLabel" layoutX="317.0" layoutY="37.0" prefHeight="17.0" prefWidth="39.0" text="Date :" />
      <DatePicker fx:id="attendanceDateDatePicker" layoutX="356.0" layoutY="33.0" />
      <Label fx:id="attendanceStatusLabel" layoutX="11.0" layoutY="121.0" prefHeight="17.0" prefWidth="105.0" text="Attendance Status :" />
      <ComboBox fx:id="attendanceStatusComboBox" layoutX="125.0" layoutY="117.0" prefWidth="150.0" />
      <Button layoutX="80.0" layoutY="188.0" mnemonicParsing="false" onAction="#saveButtonOnAction" text="Save" />
      <Button layoutX="180.0" layoutY="188.0" mnemonicParsing="false" onAction="#backButtonOnAction" text="Back" />
   </children>
</AnchorPane>
