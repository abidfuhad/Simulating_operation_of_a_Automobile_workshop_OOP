<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.simulating_operation_of_a_automobile_workshop_oop.Abid.Technician.Controller.U1G5_recordUsedPartsViewController">
   <children>
      <Label layoutX="214.0" layoutY="20.0" text="Record Used Parts" underline="true">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Button layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#backButton" text="&lt; Back" />
      <TableView fx:id="assignedJobTableView" layoutX="14.0" layoutY="69.0" prefHeight="185.0" prefWidth="574.0">
         <columns>
            <TableColumn fx:id="jobIdColumn" prefWidth="113.0" text="Job ID" />
            <TableColumn fx:id="vehicleColumn" prefWidth="141.0" text="Vehicle" />
            <TableColumn fx:id="complaintColumn" prefWidth="194.0" text="Complaint" />
            <TableColumn fx:id="statusColumn" prefWidth="125.0" text="Status" />
         </columns>
      </TableView>
      <Label layoutX="20.0" layoutY="269.0" text="Part:">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <ComboBox fx:id="partComboBox" layoutX="60.0" layoutY="266.0" prefWidth="220.0" promptText="Select Part" />
      <Label layoutX="20.0" layoutY="305.0" text="Quantity:">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <TextField fx:id="quantityField" layoutX="87.0" layoutY="302.0" prefWidth="80.0" />
      <Button layoutX="240.0" layoutY="337.0" mnemonicParsing="false" onAction="#saveButton" prefHeight="35.0" prefWidth="120.0" text="Save" />
   </children>
</AnchorPane>
