<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.simulating_operation_of_a_automobile_workshop_oop.Abid.Technician.Controller.U1G4_addServiceNotesViewController">
   <children>
      <Label layoutX="218.0" layoutY="28.0" text="Add Service Note" underline="true">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Button layoutX="23.0" layoutY="28.0" mnemonicParsing="false" onAction="#backButton" text="&lt; Back" />
      <TableView fx:id="assignedJobTableView" layoutX="18.0" layoutY="69.0" prefHeight="169.0" prefWidth="568.0">
         <columns>
            <TableColumn fx:id="jobIdColumn" prefWidth="115.0" text="Job ID" />
            <TableColumn fx:id="vehicleColumn" prefWidth="161.0" text="Vehicle" />
            <TableColumn fx:id="complaintColumn" prefWidth="128.0" text="Complaint" />
            <TableColumn fx:id="statusColumn" prefWidth="150.0" text="Status" />
         </columns>
      </TableView>
      <TextArea fx:id="serviceNoteTextArea" layoutX="18.0" layoutY="277.0" prefHeight="70.0" prefWidth="568.0" promptText="e.g., Changed engine oil" wrapText="true" />
      <Button layoutX="230.0" layoutY="351.0" mnemonicParsing="false" onAction="#saveNoteButton" prefHeight="35.0" prefWidth="140.0" text="Save Note" />
      <Label layoutX="18.0" layoutY="258.0" text="Note:">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
