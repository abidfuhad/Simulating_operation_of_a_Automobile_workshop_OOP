<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="499.0" prefWidth="740.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.simulating_operation_of_a_automobile_workshop_oop.Customer_Service_Manager.Controller.Customer_ListViewController">
   <children>
      <Button layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#backBtn" styleClass="back-button" text="&lt; Back" />
      <TextField fx:id="searchTxtFld" layoutX="66.0" layoutY="191.0" prefWidth="280.0" promptText="Search by Name or Phone" />
      <Button layoutX="370.0" layoutY="186.0" mnemonicParsing="false" onAction="#searchBtn" prefHeight="36.0" prefWidth="79.0" styleClass="primary-button" text="Search" />
      <Label layoutX="326.0" layoutY="48.0" text="Customer List">
         <font>
            <Font name="System Bold Italic" size="25.0" />
         </font>
      </Label>
      <TableView fx:id="customerListTbl" layoutX="66.0" layoutY="250.0" prefHeight="200.0" prefWidth="608.0">
        <columns>
          <TableColumn fx:id="customerIDCol" prefWidth="161.0" text="Customer ID" />
          <TableColumn fx:id="nameCol" prefWidth="119.0" text="Name" />
            <TableColumn fx:id="phoneCol" prefWidth="152.0" text="Phone" />
            <TableColumn fx:id="emailCol" prefWidth="175.0" text="Email" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
